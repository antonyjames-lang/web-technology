# Yojana Mitra - Backend Configuration
# Copy this file to .env and fill in your values

# MongoDB Connection
# Can be local (mongodb://localhost:27017/yojana_mitra) or MongoDB Atlas (mongodb+srv://<user>:<password>@cluster.mongodb.net/yojana_mitra)
# If local MongoDB is not running, the application will automatically fall back to in-memory mongomock for effortless local testing.
MONGODB_URI=mongodb://localhost:27017/yojana_mitra
MONGODB_DB=yojana_mitra

# Security Keys
DJANGO_SECRET_KEY=yojana-mitra-civic-django-super-secret-key-change-in-production
JWT_SECRET=yojana-mitra-jwt-civic-secret-key-minimum-32-chars-long
DEBUG=True

# Gmail SMTP Configuration (for sending real 6-digit OTPs)
# Note: Use a Gmail App Password (16 characters from Google Account -> Security -> App passwords), NOT your account password.
# If left empty, the server operates in development mode and provides the generated OTP directly in the API response.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
